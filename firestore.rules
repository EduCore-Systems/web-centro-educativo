rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de seguridad
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'user_admin' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user_admin'
      );
    }

    // 1. Colección USERS (Admins, Personal, Padres)
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Solo el propio usuario puede editar su perfil o un Administrador
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 2. Colección STUDENTS (Alumnos y Preinscripciones)
    match /students/{studentId} {
      // Público solo para crear (Formulario de Preinscripción en la web pública)
      allow create: if true;
      // Lectura: Administradores o el Padre vinculado del alumno
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.studentID_login == request.auth.token.studentId
      ));
      // Modificación de servicios: El padre puede actualizar a sus hijos, o el Admin
      allow update: if isAdmin() || (isAuthenticated() && resource.data.parentId == request.auth.uid);
      // Borrado: Exclusivo de Administradores
      allow delete: if isAdmin();
    }

    // 3. Colección NEWS (Noticias institucionales)
    match /news/{newsId} {
      allow read: if true; // Público (Landing web institucional)
      allow write: if isAdmin(); // Solo administradores publican noticias
    }

    // 4. Colecciones Académicas y Servicios Escolares (Cursos, Materias, Horarios, Deportes, Transporte)
    match /courses/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /subjects/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /schedules/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /sports/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /transport_routes/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Colección PAYMENTS (Finanzas)
    match /payments/{document} {
      // Un padre puede ver solo sus propios pagos, el Admin ve todos
      allow read: if isAdmin() || (isAuthenticated() && resource.data.parentEmail == request.auth.token.email);
      // Solo el Administrador puede registrar o alterar pagos
      allow write: if isAdmin();
    }
  }
}
