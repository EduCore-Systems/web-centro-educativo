rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección users (Perfiles de padres, administradores, etc.)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.role == 'user_admin' || 
        request.auth.uid == userId
      );
    }
    
    // Colección students (Datos y login de alumnos)
    match /students/{studentId} {
      // Permitir creación y lectura para inscripción pública
      allow read, create: if true;
      // Permitir edición y borrado para administradores autenticados
      allow update, delete: if request.auth != null;
    }

    // Colección news (Noticias del portal)
    match /news/{newsId} {
      // Las noticias son públicas para que cualquier visitante del sitio pueda leerlas
      allow read: if true;
      
      // Solo administradores autenticados (con claim de admin o perfil en la bd con rol user_admin) pueden escribir
      allow write: if request.auth != null && (
        request.auth.token.role == 'user_admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user_admin')
      );
    }
  }
}
